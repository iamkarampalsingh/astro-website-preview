---
const { compact = false } = Astro.props;
---
<a class={`logo-lockup ${compact ? 'logo-lockup--compact' : ''}`} href="/" aria-label="WINKS London home">
  <svg class="logo-mark" viewBox="0 0 74 74" role="img" aria-label="WINKS emblem">
    <circle class="logo-ring logo-ring--outer" cx="37" cy="37" r="31"></circle>
    <circle class="logo-ring logo-ring--inner" cx="37" cy="37" r="24"></circle>
    <path class="logo-wink" d="M22 30c3-4 7-4 10 0l5 7 5-7c3-4 7-4 10 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
    <path class="logo-wink logo-wink--lower" d="M26 45c4 3 18 3 22 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    <circle class="logo-star" cx="37" cy="18" r="1.4"></circle>
  </svg>
  <span class="logo-copy">
    <span class="logo-word">WINKS</span>
    <span class="logo-sub">LONDON</span>
  </span>
</a>
