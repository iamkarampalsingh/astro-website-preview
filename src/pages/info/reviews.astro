---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { reviews } from '../../data/site.js';
---
<BaseLayout title="WINKS London Reviews · Private client notes" description="Read WINKS London client notes about discretion, atmosphere, communication and the outcall experience.">
  <section class="page-hero"><span class="page-hero__watermark">NOTES</span><div class="container-fluid px-3 px-lg-4 page-hero__content"><div class="breadcrumb-line"><a href="/">Home</a><span>/</span><a href="/info">Info</a><span>/</span><span class="current">Reviews</span></div><span class="eyebrow mt-4">WINKS London reviews</span><h1>What the mood<br /><em>leaves behind.</em></h1><p>Private feedback about the details guests notice: a calm arrival, clear communication and an atmosphere that feels considered.</p></div></section>
  <section class="section section--line"><div class="container-fluid px-3 px-lg-4"><div class="collection-header"><div><span class="eyebrow">Client notes</span><h2 class="section-title">The little things<br /><em>matter.</em></h2></div><p class="lead-copy">These are sample review placeholders for the prototype. Replace them with your verified review feed before launch.</p></div><div class="review-grid">{reviews.map((review) => <article class="review-card"><div class="review-card__stars">✦ ✦ ✦ ✦ ✦</div><blockquote>“{review.quote}”</blockquote><div class="review-card__by"><strong>{review.name}</strong>{review.meta}</div></article>)}</div></div></section>
  <section class="section section--white"><div class="container-fluid px-3 px-lg-4"><div class="content-grid"><div><span class="eyebrow">Leave a private note</span><h2 class="section-title">Tell us how<br /><em>it felt.</em></h2><p class="lead-copy">We welcome thoughtful feedback. It helps us keep the standard high and the guest journey clear.</p></div><div class="form-shell"><div class="form-shell__header"><h2>Share feedback</h2><span>Private form</span></div><div class="form-shell__body"><form data-demo-form data-success-message="Thank you — your feedback has been received privately." novalidate><div class="row g-3"><div class="col-md-6"><label class="form-label" for="review-name">Name or initials</label><input class="form-control" id="review-name" name="name" required /></div><div class="col-md-6"><label class="form-label" for="review-email">Email</label><input class="form-control" id="review-email" name="email" type="email" required /></div><div class="col-12"><label class="form-label" for="review-message">Your note</label><textarea class="form-control" id="review-message" name="message" rows="5" required></textarea></div><div class="col-12"><div class="form-check"><input class="form-check-input" id="review-consent" type="checkbox" required /><label class="form-check-label" for="review-consent">I understand WINKS may contact me about this feedback.</label></div></div><div class="col-12"><button class="btn btn-gold" type="submit">Send privately <span aria-hidden="true">↗</span></button></div><div class="col-12"><div class="form-success" data-form-success role="status"></div></div></div></form></div></div></div></div></section>
</BaseLayout>
