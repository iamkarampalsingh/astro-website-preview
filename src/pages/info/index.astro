---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { infoPages, faqs, reviews } from '../../data/site.js';
---
<BaseLayout title="WINKS London Info · Terms, FAQ & Reviews" description="WINKS London terms of enjoyment, client code of conduct, frequently asked questions and reviews.">
  <section class="page-hero">
    <span class="page-hero__watermark">INFO</span>
    <div class="container-fluid px-3 px-lg-4 page-hero__content">
      <div class="breadcrumb-line"><a href="/">Home</a><span>/</span><span class="current">Info</span></div>
      <span class="eyebrow mt-4">Good to know</span>
      <h1>Everything<br /><em>in the clear.</em></h1>
      <p>Our terms, house standards, answers and private client notes — so you know what to expect before you reserve.</p>
    </div>
  </section>

  <section class="section section--line">
    <div class="container-fluid px-3 px-lg-4">
      <div class="collection-header"><div><span class="eyebrow">Start here</span><h2 class="section-title">The important<br /><em>bits.</em></h2></div><p class="lead-copy">Clear expectations make a calmer experience. Please take a moment to read the WINKS standards before booking.</p></div>
      <div class="full-collection-grid">
        {infoPages.map((page, index) => (
          <a class="service-card" href={`/info/${page.slug}`}><div class="service-card__top"><span class="service-card__index">0{index + 1}</span><span class="tag">Read first</span></div><div><h3>{page.label}</h3><p>{page.intro}</p></div><div class="service-card__bottom"><span class="service-card__duration">Open page</span><span class="service-card__arrow" aria-hidden="true">↗</span></div></a>
        ))}
        <a class="service-card" href="/info/faq"><div class="service-card__top"><span class="service-card__index">03</span><span class="tag">Answers</span></div><div><h3>FAQ</h3><p>Quick answers about outcall visits, hours, guests, preparation and reservations.</p></div><div class="service-card__bottom"><span class="service-card__duration">8 questions</span><span class="service-card__arrow" aria-hidden="true">↗</span></div></a>
        <a class="service-card" href="/info/reviews"><div class="service-card__top"><span class="service-card__index">04</span><span class="tag">Client notes</span></div><div><h3>WINKS London Reviews</h3><p>Private feedback about the atmosphere, the communication and the little details.</p></div><div class="service-card__bottom"><span class="service-card__duration">Read notes</span><span class="service-card__arrow" aria-hidden="true">↗</span></div></a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container-fluid px-3 px-lg-4">
      <div class="content-grid"><div><span class="eyebrow">A quick answer</span><h2 class="section-title">Before you<br /><em>arrive.</em></h2><p class="lead-copy">WINKS is a private, adults-only service. Availability is confirmed in writing, and every visit is shaped around clear communication and mutual respect.</p><a class="btn btn-outline-gold mt-3" href="/info/faq">Open the FAQ <span aria-hidden="true">↗</span></a></div><div class="accordion" id="quickFaq">{faqs.slice(0, 4).map((faq, index) => <div class="accordion-item"><h3 class="accordion-header"><button class={`accordion-button ${index !== 0 ? 'collapsed' : ''}`} type="button" data-bs-toggle="collapse" data-bs-target={`#quick-faq-${index}`} aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`quick-faq-${index}`}>{faq.q}</button></h3><div id={`quick-faq-${index}`} class={`accordion-collapse collapse ${index === 0 ? 'show' : ''}`} data-bs-parent="#quickFaq"><div class="accordion-body">{faq.a}</div></div></div>)}</div></div>
    </div>
  </section>
</BaseLayout>
