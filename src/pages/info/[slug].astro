---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { infoPages } from '../../data/site.js';
export function getStaticPaths() { return infoPages.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<BaseLayout title={`${page.title} · WINKS London`} description={page.intro}>
  <section class="page-hero"><span class="page-hero__watermark">INFO</span><div class="container-fluid px-3 px-lg-4 page-hero__content"><div class="breadcrumb-line"><a href="/">Home</a><span>/</span><a href="/info">Info</a><span>/</span><span class="current">{page.label}</span></div><span class="eyebrow mt-4">{page.eyebrow}</span><h1>{page.title}</h1><p>{page.intro}</p></div></section>
  <section class="section section--line"><div class="container-fluid px-3 px-lg-4"><div class="content-grid"><div class="content-copy"><span class="eyebrow">Please read before reserving</span><h2>Good manners<br /><em>feel good.</em></h2>{page.body.map((paragraph) => <p>{paragraph}</p>)}<a class="btn btn-gold mt-3" href="/contact/reserve">I understand — reserve <span aria-hidden="true">↗</span></a></div><aside class="content-aside"><div class="aside-card"><span class="eyebrow">House points</span><ul class="aside-list">{page.points.map((point) => <li>{point}</li>)}</ul></div><div class="aside-card"><span class="eyebrow">Still unsure?</span><h3>Ask WINKS.</h3><p>We would rather answer a clear question before the visit than leave anything open to assumption.</p><a class="text-link" href="/contact/email-winks">Send an enquiry <span aria-hidden="true">↗</span></a></div></aside></div></div></section>
  <section class="section section--tight section--white"><div class="container-fluid px-3 px-lg-4"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">The next step</span><h2 class="section-title mb-0">Make it<br /><em>simple.</em></h2></div><a class="btn btn-outline-gold" href="/contact/reserve">Make a reservation <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
