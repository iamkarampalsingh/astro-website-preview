---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqs } from '../../data/site.js';
---
<BaseLayout title="WINKS London FAQ · Frequently asked questions" description="Answers about WINKS London outcall visits, hours, reservations, guests, preparation and privacy.">
  <section class="page-hero"><span class="page-hero__watermark">FAQ</span><div class="container-fluid px-3 px-lg-4 page-hero__content"><div class="breadcrumb-line"><a href="/">Home</a><span>/</span><a href="/info">Info</a><span>/</span><span class="current">FAQ</span></div><span class="eyebrow mt-4">Questions, answered</span><h1>Before the<br /><em>first WINKS.</em></h1><p>A quick, clear guide to how the private outcall experience works.</p></div></section>
  <section class="section section--line"><div class="container-fluid px-3 px-lg-4"><div class="content-grid"><div><span class="eyebrow">The FAQ</span><h2 class="section-title">Good to know<br /><em>before you book.</em></h2><p class="lead-copy mb-4">If your question is not here, send the team a private note. We are happy to guide you without making you feel like you should already know the answer.</p><div class="accordion" id="faqAccordion">{faqs.map((faq, index) => <div class="accordion-item"><h3 class="accordion-header"><button class={`accordion-button ${index !== 0 ? 'collapsed' : ''}`} type="button" data-bs-toggle="collapse" data-bs-target={`#faq-${index}`} aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`faq-${index}`}>{faq.q}</button></h3><div id={`faq-${index}`} class={`accordion-collapse collapse ${index === 0 ? 'show' : ''}`} data-bs-parent="#faqAccordion"><div class="accordion-body">{faq.a}</div></div></div>)}</div></div><aside class="content-aside"><div class="aside-card"><span class="eyebrow">Quick line</span><h3>Still curious?</h3><p>For a direct answer about a date, area or experience, the reservation team is the quickest route.</p><a class="btn btn-gold w-100" href="/contact/email-winks">Email WINKS <span aria-hidden="true">↗</span></a></div><div class="aside-card"><span class="eyebrow">Remember</span><ul class="aside-list"><li>Adults 18+ only</li><li>By appointment</li><li>Home & hotel outcall</li><li>1PM–2AM service hours</li></ul></div></aside></div></div></section>
</BaseLayout>
