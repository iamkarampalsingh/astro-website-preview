---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/site.js';
export function getStaticPaths() { return posts.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
---
<BaseLayout title={`${post.title} · WINKS Journal`} description={post.excerpt}>
  <section class="page-hero"><span class="page-hero__watermark">NOTE</span><div class="container-fluid px-3 px-lg-4 page-hero__content"><div class="breadcrumb-line"><a href="/">Home</a><span>/</span><a href="/blog">Blog</a><span>/</span><span class="current">{post.title}</span></div><span class="eyebrow mt-4">{post.category}</span><h1>{post.title}</h1><p>{post.excerpt}</p><div class="article-meta"><span>{post.date}</span><span>{post.read}</span></div></div></section>
  <section class="section section--line"><div class="container-fluid px-3 px-lg-4"><div class="content-grid"><article class="article-copy"><span class="eyebrow">A WINKS note</span>{post.body.map((paragraph, index) => index === 0 ? <><h2>Start with the room.</h2><p>{paragraph}</p></> : <p>{paragraph}</p>)}<div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-gold" href="/massages">Explore the collection <span aria-hidden="true">↗</span></a><a class="btn btn-outline-light" href="/blog">Back to journal</a></div></article><aside class="content-aside"><div class="aside-card"><span class="eyebrow">The WINKS edit</span><h3>Take your time.</h3><p>Luxury is often just a little more space: space to prepare, space to communicate and space to let the evening unfold.</p><a class="text-link" href="/about/winks-way">Read the WINKS Way <span aria-hidden="true">↗</span></a></div></aside></div></div></section>
</BaseLayout>
