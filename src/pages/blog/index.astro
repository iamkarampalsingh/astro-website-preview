---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/site.js';
---
<BaseLayout title="The WINKS Journal · London outcall notes" description="The WINKS Journal: notes on private atmosphere, choosing your WINKS mood and outcall etiquette.">
  <section class="page-hero"><span class="page-hero__watermark">JOURNAL</span><div class="container-fluid px-3 px-lg-4 page-hero__content"><div class="breadcrumb-line"><a href="/">Home</a><span>/</span><span class="current">Blog</span></div><span class="eyebrow mt-4">The WINKS Journal</span><h1>Notes for a<br /><em>slower evening.</em></h1><p>Thoughts on atmosphere, private outcall etiquette and choosing the WINKS mood that feels right for you.</p></div></section>
  <section class="section section--line"><div class="container-fluid px-3 px-lg-4"><div class="collection-header"><div><span class="eyebrow">The journal</span><h2 class="section-title">A little<br /><em>inspiration.</em></h2></div><p class="lead-copy">A calm corner for the details that make an evening feel considered. New notes will be added here as WINKS grows.</p></div><div class="blog-grid">{posts.map((post) => <article class="blog-card"><img class="blog-card__image" src="/images/winks-journal.jpg" alt="Black journal, gold pen and white rose" loading="lazy" /><div class="blog-card__meta"><span>{post.category}</span><span>{post.date}</span></div><h2>{post.title}</h2><p>{post.excerpt}</p><a class="text-link" href={`/blog/${post.slug}`}>Read the note <span aria-hidden="true">↗</span></a></article>)}</div></div></section>
  <section class="section section--white section--tight"><div class="container-fluid px-3 px-lg-4"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Want the short version?</span><h2 class="section-title mb-0">Ask the<br /><em>WINKS team.</em></h2></div><a class="btn btn-outline-gold" href="/contact/email-winks">Email WINKS <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
