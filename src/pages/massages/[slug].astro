---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/site.js';
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const words = service.name.replace(' by WINKS', '').split(' ');
const firstLine = words.slice(0, Math.max(1, Math.ceil(words.length / 2))).join(' ');
const secondLine = words.slice(Math.max(1, Math.ceil(words.length / 2))).join(' ');
---
<BaseLayout title={`${service.name} · WINKS London`} description={service.description}>
  <section class="page-hero service-detail-hero"><span class="page-hero__watermark">{service.name.split(' ')[0]}</span><div class="container-fluid px-3 px-lg-4 page-hero__content"><div class="breadcrumb-line"><a href="/">Home</a><span>/</span><a href="/massages">Massage Collection</a><span>/</span><span class="current">{service.name}</span></div><span class="eyebrow mt-4">{service.eyebrow}</span><h1>{firstLine}<br /><em>{secondLine}</em></h1><p>{service.short}</p></div></section>
  <section class="section section--line"><div class="container-fluid px-3 px-lg-4"><div class="service-detail-grid"><div><span class="eyebrow">The experience</span><p class="service-detail__description">{service.description}</p><div class="detail-facts"><div class="detail-fact"><span class="detail-fact__label">Timing</span><strong>{service.duration}</strong></div><div class="detail-fact"><span class="detail-fact__label">Setting</span><strong>Home / hotel</strong></div><div class="detail-fact"><span class="detail-fact__label">Guests</span><strong>{service.tags.includes('Two guests') ? 'Two guests' : 'One guest'}</strong></div></div><p class="form-note">Every WINKS booking is confirmed privately. The collection page is a guide — your final timing, quote and agreed brief are confirmed by the team before arrival.</p><div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-gold" href={`/contact/reserve?experience=${service.slug}`}>Reserve this experience <span aria-hidden="true">↗</span></a><a class="btn btn-outline-light" href="/contact/email-winks">Ask a question</a></div></div><div class="service-visual" aria-hidden="true"><div class="service-visual__mark"><span>W</span></div><div class="service-visual__word">WINKS</div></div></div></div></section>
  <section class="section section--white section--tight"><div class="container-fluid px-3 px-lg-4"><div class="content-grid"><div><span class="eyebrow">A clear beginning</span><h2 class="section-title">Set the tone<br /><em>before arrival.</em></h2><p class="lead-copy">When you reserve, tell us the date, time, location and anything that will help us understand the mood you want. We will confirm the details directly so your evening begins with confidence.</p></div><div class="point-list"><li>Adults 18+ only</li><li>By appointment</li><li>Clear boundaries</li><li>Private communication</li></div></div></div></section>
</BaseLayout>
