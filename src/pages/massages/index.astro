---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/site.js';
---
<BaseLayout title="WINKS London Massage Collection · Private outcall experiences" description="Explore the full WINKS London massage collection: signature, immersive, shared, playful and soft private outcall experiences.">
  <section class="page-hero"><span class="page-hero__watermark">WINKS</span><div class="container-fluid px-3 px-lg-4 page-hero__content"><div class="breadcrumb-line"><a href="/">Home</a><span>/</span><span class="current">Massage Collection</span></div><span class="eyebrow mt-4">The WINKS collection</span><h1>Choose your<br /><em>mood.</em></h1><p>Eleven private experiences. One considered standard. Find the one that feels right for tonight.</p></div></section>
  <section class="section section--line"><div class="container-fluid px-3 px-lg-4"><div class="collection-intro"><div class="collection-intro__copy"><span class="eyebrow">A little guide</span><h2 class="section-title">Start with a<br /><em>feeling.</em></h2><p class="lead-copy">You do not need to know the perfect words. Signature is classic and unhurried; Tantra is more immersive; Double and Lovers are for two; Taboo and Naughty are playful; Pink is softer and sensory.</p></div><p class="collection-intro__aside">All experiences are arranged privately, by appointment, with timing, location and boundaries agreed before your visit.</p></div><div class="full-collection-grid">{services.map((service, index) => <a class="service-card" href={`/massages/${service.slug}`}><div class="service-card__top"><span class="service-card__index">{String(index + 1).padStart(2, '0')}</span><div class="service-card__tags">{service.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}</div></div><div><h3>{service.name}</h3><p>{service.short}</p></div><div class="service-card__bottom"><span class="service-card__duration">{service.duration}</span><span class="service-card__arrow" aria-hidden="true">↗</span></div></a>)}</div></div></section>
  <section class="section section--white section--tight"><div class="container-fluid px-3 px-lg-4"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Not sure which one?</span><h2 class="section-title mb-0">Tell us the<br /><em>mood.</em></h2></div><a class="btn btn-outline-gold" href="/contact/email-winks">Ask WINKS for guidance <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
