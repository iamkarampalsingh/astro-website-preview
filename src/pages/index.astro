---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCalendar from '../components/BookingCalendar.astro';
import { services, reviews } from '../data/site.js';
const featuredServices = services.slice(0, 8);
---
<BaseLayout title="WINKS London · Private outcall experiences" description="WINKS London is a discreet, premium outcall massage service across London." active="home">
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img src="/images/winks-hero.jpg" alt="Black silk, a white orchid and warm gold candlelight" />
    </div>
    <div class="container-fluid px-3 px-lg-4 hero__content">
      <div class="hero__copy">
        <span class="eyebrow">Private outcall experiences · London</span>
        <h1 class="display-title">A little<br /><em>luxury.</em><br />A lot of WINKS.</h1>
        <p class="lead-copy">A calm, discreet and beautifully atmospheric outcall service for evenings that deserve to feel different. At home, in your suite, entirely on your terms.</p>
        <div class="hero__actions">
          <a class="btn btn-gold" href="/contact/reserve">Make a reservation <span aria-hidden="true">↗</span></a>
          <a class="btn btn-outline-light" href="/massages">Explore the collection</a>
        </div>
        <div class="hero__meta"><span>Adults 18+ only</span><span>Home & hotel outcall</span><span>1PM–2AM</span></div>
      </div>
    </div>
    <div class="hero__aside"><span>Scroll to explore</span></div>
  </section>

  <section class="section section--line">
    <div class="container-fluid px-3 px-lg-4">
      <div class="intro-grid">
        <div>
          <span class="eyebrow">Welcome to WINKS London</span>
          <h2 class="section-title">The art of<br /><em>switching off.</em></h2>
        </div>
        <div class="intro-grid__aside">
          <p class="lead-copy">WINKS makes private time feel easy. Choose a mood, share a few details and let us bring the atmosphere to your door — quietly, thoughtfully and without the rush.</p>
          <a class="text-link" href="/about/winks-way">Discover the WINKS Way <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="stat-grid">
        <div class="stat"><span class="stat__number">01</span><span class="stat__label">A private arrival</span></div>
        <div class="stat"><span class="stat__number">02</span><span class="stat__label">A tailored mood</span></div>
        <div class="stat"><span class="stat__number">03</span><span class="stat__label">A calmer way to end the day</span></div>
      </div>
    </div>
  </section>

  <section class="section section--white" id="collection-preview">
    <div class="container-fluid px-3 px-lg-4">
      <div class="collection-header">
        <div>
          <span class="eyebrow">The collection</span>
          <h2 class="section-title">Find your<br /><em>WINKS mood.</em></h2>
        </div>
        <p class="lead-copy">Signature, immersive, playful or soft. Every experience is private, carefully paced and arranged around the evening you want.</p>
      </div>
      <div class="collection-grid">
        {featuredServices.map((service, index) => (
          <a class="service-card" href={`/massages/${service.slug}`}>
            <div class="service-card__top">
              <span class="service-card__index">0{index + 1}</span>
              <div class="service-card__tags">{service.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}</div>
            </div>
            <div>
              <h3>{service.name}</h3>
              <p>{service.short}</p>
            </div>
            <div class="service-card__bottom"><span class="service-card__duration">{service.duration}</span><span class="service-card__arrow" aria-hidden="true">↗</span></div>
          </a>
        ))}
      </div>
      <div class="collection-footer"><span>11 experiences · one private standard</span><a class="text-link" href="/massages">View the full collection <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="section section--line p-0">
    <div class="split-grid">
      <div class="split-grid__media">
        <img src="/images/winks-outcall.jpg" alt="A private hotel suite prepared with white linen and warm gold light" loading="lazy" />
        <span class="media-stamp">At your door.</span>
      </div>
      <div class="split-grid__content">
        <span class="eyebrow">WINKS Valet</span>
        <h2 class="section-title">The luxury<br /><em>of not leaving.</em></h2>
        <p class="lead-copy">Your evening should not end with a taxi queue or a bright hotel lobby. WINKS comes to private homes and hotels across London, with access details and arrival timing confirmed in advance.</p>
        <ul class="point-list">
          <li>Home & hotel outcall</li>
          <li>Discreet arrival</li>
          <li>1PM–2AM service hours</li>
          <li>London-wide coverage</li>
        </ul>
        <a class="btn btn-outline-gold" href="/about/winks-valet">How WINKS Valet works</a>
      </div>
    </div>
  </section>

  <section class="section section--line">
    <div class="container-fluid px-3 px-lg-4">
      <div class="intro-grid">
        <div>
          <span class="eyebrow">Three small steps</span>
          <h2 class="section-title">Make the night<br /><em>feel effortless.</em></h2>
        </div>
        <div class="intro-grid__aside"><p class="lead-copy">You do not need to know exactly what to ask for. Begin with the feeling you want and we will take care of the details.</p><a class="text-link" href="/info/faq">Read the FAQ <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="process-grid">
        <div class="process-card"><span class="process-card__number">01</span><h3>Choose a mood</h3><p>Explore the collection or tell us whether you want a signature, shared, immersive, playful or soft experience.</p></div>
        <div class="process-card"><span class="process-card__number">02</span><h3>Share the details</h3><p>Use the reservation calendar to send your preferred date, time, location and guest details. It takes less than two minutes.</p></div>
        <div class="process-card"><span class="process-card__number">03</span><h3>Let WINKS arrive</h3><p>We reply privately to confirm availability, the final quote and the agreed brief before anything is booked.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--white" id="home-booking">
    <div class="container-fluid px-3 px-lg-4">
      <div class="collection-header"><div><span class="eyebrow">Reserve from the homepage</span><h2 class="section-title">Your date.<br /><em>Your WINKS.</em></h2></div><p class="lead-copy">Use the calendar below to see the experience rate, choose a date and select an available time. Your completed request is prepared for both WhatsApp and email.</p></div>
      <BookingCalendar id="booking-home" compact />
    </div>
  </section>

  <section class="section quote-section section--line">
    <div class="container-fluid px-3 px-lg-4">
      <div class="collection-header">
        <div><span class="eyebrow">Private client notes</span><h2 class="section-title">What the<br /><em>mood leaves behind.</em></h2></div>
        <p class="lead-copy">A few words from the people who value the WINKS way of doing things. Replace these sample entries with your verified review feed when the site goes live.</p>
      </div>
      <div class="review-grid">
        {reviews.map((review) => (
          <article class="review-card">
            <div class="review-card__stars">✦ ✦ ✦ ✦ ✦</div>
            <blockquote>“{review.quote}”</blockquote>
            <div class="review-card__by"><strong>{review.name}</strong>{review.meta}</div>
          </article>
        ))}
      </div>
      <div class="text-end mt-4"><a class="text-link" href="/info/reviews">Read all WINKS London reviews <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container-fluid px-3 px-lg-4">
      <div class="cinema-card">
        <img src="/images/winks-cinema.jpg" alt="A vintage film projector and gold film reels" loading="lazy" />
        <div class="cinema-card__content"><a class="play-button" href="/cinema" aria-label="Enter WINKS Cinema">▶</a><span class="eyebrow">WINKS Cinema</span><h3>See the atmosphere<br />before you arrive.</h3><p>Video stories, mood films and a little more of the WINKS world.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
