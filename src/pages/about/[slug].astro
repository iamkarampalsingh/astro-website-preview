---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutPages } from '../../data/site.js';

export function getStaticPaths() {
  return aboutPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---
<BaseLayout title={`${page.title} · WINKS London`} description={page.intro}>
  <section class="page-hero">
    <span class="page-hero__watermark">WINKS</span>
    <div class="container-fluid px-3 px-lg-4 page-hero__content">
      <div class="breadcrumb-line"><a href="/">Home</a><span>/</span><a href="/about">About</a><span>/</span><span class="current">{page.label}</span></div>
      <span class="eyebrow mt-4">{page.eyebrow}</span>
      <h1>{page.title}</h1>
      <p>{page.intro}</p>
    </div>
  </section>

  <section class="section section--line">
    <div class="container-fluid px-3 px-lg-4">
      <div class="content-grid">
        <div class="content-copy">
          <span class="eyebrow">The WINKS standard</span>
          <h2>It should feel<br /><em>effortless.</em></h2>
          {page.body.map((paragraph) => <p>{paragraph}</p>)}
          <a class="btn btn-gold mt-3" href="/contact/reserve">Make a reservation <span aria-hidden="true">↗</span></a>
        </div>
        <aside class="content-aside">
          <div class="aside-card"><span class="eyebrow">In this page</span><ul class="aside-list">{page.points.map((point) => <li>{point}</li>)}</ul></div>
          <div class="aside-card"><span class="eyebrow">Need a little guidance?</span><h3>We can help.</h3><p>Share the mood, the date and the location. Our reception team will guide you from there.</p><a class="text-link" href="/contact/email-winks">Email WINKS <span aria-hidden="true">↗</span></a></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--tight section--white">
    <div class="container-fluid px-3 px-lg-4">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">Continue exploring</span><h2 class="section-title mb-0">The details<br /><em>matter.</em></h2></div><a class="btn btn-outline-gold" href="/about">All about WINKS <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
